# Examples only: Spring Boot does not read this file. Set the server values as environment variables (shell, IntelliJ
# run configuration); put the client value into client/.env when the client needs another address.

# Client (client/.env) - optional for local runs: `npm run dev` defaults to http://localhost:8080/api
VITE_API_BASE_URL=http://localhost:8080/api

# Server - local DEV MySQL (the application reads DB_USERNAME and DB_PASSWORD;
# application-dev.properties fixes the datasource at localhost:3306/quiz_wheelz)
DB_USERNAME=root
DB_PASSWORD=

# Server - optional: another port, or extra browser origins such as a phone on the local network
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.20:5173

# Server - gameplay kill switches (both ON by default in server/src/main/resources/application.properties)
# QUIZWHEELZ_LUCK_ANSWER_ENABLED=false
# QUIZWHEELZ_RECOVERY_ENABLED=false

# Local DEV Redis is passwordless and managed by Spring Boot through server/compose.yaml.
# Its dynamic connection details are supplied by the Compose service connection.

# Production/external infrastructure examples (not local DEV defaults)
TOKEN_SECRET=replace-with-at-least-32-random-characters
DB_URL=jdbc:mysql://database-host:3306/quiz_wheelz
REDIS_HOST=redis-host
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-secret
REDIS_TIMEOUT_MS=2000
REDIS_SSL_ENABLED=true
